{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrp.local/schema/payload/ARTIFACT_REQUEST.schema.json",
  "title": "ARTIFACT_REQUEST payload",
  "description": "Host -> Runtime. Ask the Runner to upload one previously reported ARTIFACT_CANDIDATE via HTTPS PUT within the deadline (120s default). Listing artifacts is a Host Artifact Registry query, not a runtime message (differs from the early 8-request table).",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "upload_id", "upload_deadline_at", "max_bytes"],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "upload_id": { "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "upload_deadline_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" },
    "max_bytes": { "type": "integer", "minimum": 1, "maximum": 52428800 }
  }
}

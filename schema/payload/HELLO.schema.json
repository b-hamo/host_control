{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrp.local/schema/payload/HELLO.schema.json",
  "title": "HELLO payload",
  "$comment": "OWNER: Runner 담당 (WBS 2.5 핸드셰이크·Capability·버전 규칙). Draft by Host 통신 담당 from protocol doc section 4 so the envelope tests can run; field list and capability vocabulary are the owner's to finalize.",
  "description": "Runtime -> Host, first message (sequence 1). Bootstrap token goes in the HTTP Authorization header, never here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["supported_versions", "os", "runner_version", "capabilities", "monitoring_coverage", "client_nonce"],
  "properties": {
    "supported_versions": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "const": "1.0" } },
    "os": {
      "type": "object", "additionalProperties": false, "required": ["family", "build"],
      "properties": { "family": { "const": "windows" }, "build": { "type": "string", "maxLength": 32 } }
    },
    "runner_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "capabilities": {
      "type": "array", "uniqueItems": true, "maxItems": 32,
      "items": { "enum": ["gui.observe", "gui.input", "ui.automation", "filesystem.workspace", "network.internet", "artifact.export.v1"] }
    },
    "monitoring_coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["process", "file", "network", "script", "registry"],
      "properties": {
        "process": { "type": "boolean" }, "file": { "type": "boolean" }, "network": { "type": "boolean" },
        "script": { "type": "boolean" }, "registry": { "type": "boolean" }
      }
    },
    "client_nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" }
  }
}

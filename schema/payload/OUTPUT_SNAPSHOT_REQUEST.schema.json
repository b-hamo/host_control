{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Output snapshot request (artifact.output.v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "operation", "max_file_bytes", "max_total_bytes"],
  "properties": {
    "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "operation": {"enum": ["CAPTURE", "VERIFY", "RELEASE"]},
    "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 52428800},
    "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 209715200}
  }
}

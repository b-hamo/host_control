{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrp.local/schema/payload/OBSERVE_RESULT.schema.json",
  "title": "OBSERVE_RESULT payload",
  "description": "Runtime -> Host. Metadata for a PNG already uploaded via HTTPS. Host re-verifies size, PNG format, hash and decoded pixel count (<= 16 MP) before exposing it as MCP image content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "width", "height", "captured_at", "sha256", "upload_id"],
  "properties": {
    "observation_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
    "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
    "captured_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "upload_id": { "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" }
  }
}

{
  "name": "router_submit",
  "description": "Submit a registered action once. Reuse request_id; acceptance is not completion. Query status after uncertainty.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "request_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
      },
      "action_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
      }
    },
    "required": [
      "request_id",
      "action_id"
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

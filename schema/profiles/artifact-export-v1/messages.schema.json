{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrp.local/proposals/artifact-export-v1/messages.schema.json",
  "title": "artifact-export-v1: Runner Artifact and Telemetry contract",
  "$comment": "Runner implementation contract; Host adoption required. This Schema is documentation, not a runtime configuration. Includes six full-envelope types, not the complete Control protocol. Validate JSON duplicate keys/UTF-8/depth/byte limits, authenticated session, cross-message correlation, filesystem boundaries and grant state separately. Resolve locally; do not fetch $id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "session_id",
    "runtime_id",
    "generation",
    "connection_id",
    "message_id",
    "task_id",
    "action_id",
    "sequence_number",
    "timestamp",
    "nonce",
    "type",
    "correlation_id",
    "status",
    "error",
    "payload"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "session_id": {
      "$ref": "#/$defs/host_id"
    },
    "runtime_id": {
      "$ref": "#/$defs/host_id"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "connection_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/host_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "message_id": {
      "$ref": "#/$defs/uuid"
    },
    "task_id": {
      "const": null
    },
    "action_id": {
      "const": null
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "$ref": "#/$defs/utc"
    },
    "nonce": {
      "type": "string",
      "minLength": 22,
      "maxLength": 22,
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "type": {
      "enum": [
        "CHANNEL_HELLO",
        "CHANNEL_ACK",
        "SECURITY_EVENT",
        "EVENT_ACK",
        "ARTIFACT_REQUEST",
        "ARTIFACT_RESULT"
      ]
    },
    "correlation_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
    },
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$(?![\\s\\S])"
    },
    "upload_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
    },
    "candidate_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "observed_at",
        "category",
        "relative_path"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/uuid"
        },
        "observed_at": {
          "$ref": "#/$defs/utc"
        },
        "category": {
          "const": "ARTIFACT_CANDIDATE"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001f\\u007f]*[^\\\\/:*?\"<>|\\u0000-\\u001f\\u007f. ](?:\\\\[^\\\\/:*?\"<>|\\u0000-\\u001f\\u007f]*[^\\\\/:*?\"<>|\\u0000-\\u001f\\u007f. ])*$(?![\\s\\S])"
        }
      }
    },
    "request_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_event_id",
        "upload_id",
        "upload_token",
        "upload_deadline_at",
        "max_bytes"
      ],
      "properties": {
        "candidate_event_id": {
          "$ref": "#/$defs/uuid"
        },
        "upload_id": {
          "$ref": "#/$defs/upload_id"
        },
        "upload_token": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        },
        "upload_deadline_at": {
          "$ref": "#/$defs/utc"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        }
      }
    },
    "result_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_event_id",
        "upload_id",
        "transfer",
        "bytes_sent"
      ],
      "properties": {
        "candidate_event_id": {
          "$ref": "#/$defs/uuid"
        },
        "upload_id": {
          "$ref": "#/$defs/upload_id"
        },
        "transfer": {
          "enum": [
            "UPLOADED",
            "FAILED",
            "EXPIRED"
          ]
        },
        "bytes_sent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 52428800
        }
      }
    },
    "artifact_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "recommended_next_step"
      ],
      "properties": {
        "code": {
          "enum": [
            "CANDIDATE_UNAVAILABLE",
            "ARTIFACT_BUSY",
            "ARTIFACT_BLOCKED",
            "UPLOAD_FAILED",
            "UPLOAD_EXPIRED",
            "SESSION_TERMINATED",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
        },
        "retryable": {
          "const": false
        },
        "recommended_next_step": {
          "const": null
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "CHANNEL_HELLO"
        },
        "correlation_id": {
          "const": null
        },
        "status": {
          "const": null
        },
        "error": {
          "const": null
        },
        "connection_id": {
          "const": null
        },
        "sequence_number": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel"
          ],
          "properties": {
            "channel": {
              "const": "telemetry"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "CHANNEL_ACK"
        },
        "connection_id": {
          "$ref": "#/$defs/host_id"
        },
        "correlation_id": {
          "$ref": "#/$defs/uuid"
        },
        "sequence_number": {
          "const": 1
        },
        "status": {
          "const": "OK"
        },
        "error": {
          "const": null
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "max_event_bytes"
          ],
          "properties": {
            "channel": {
              "const": "telemetry"
            },
            "max_event_bytes": {
              "const": 16384
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "SECURITY_EVENT"
        },
        "correlation_id": {
          "const": null
        },
        "status": {
          "const": null
        },
        "error": {
          "const": null
        },
        "connection_id": {
          "$ref": "#/$defs/host_id"
        },
        "payload": {
          "$ref": "#/$defs/candidate_payload"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "EVENT_ACK"
        },
        "connection_id": {
          "$ref": "#/$defs/host_id"
        },
        "correlation_id": {
          "$ref": "#/$defs/uuid"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_id"
          ],
          "properties": {
            "event_id": {
              "$ref": "#/$defs/uuid"
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "STORED"
            },
            "error": {
              "const": null
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "REJECTED"
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "const": "STORAGE_REJECTED"
                }
              }
            }
          }
        }
      ]
    },
    {
      "properties": {
        "type": {
          "const": "ARTIFACT_REQUEST"
        },
        "correlation_id": {
          "const": null
        },
        "status": {
          "const": null
        },
        "error": {
          "const": null
        },
        "connection_id": {
          "$ref": "#/$defs/host_id"
        },
        "payload": {
          "$ref": "#/$defs/request_payload"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "ARTIFACT_RESULT"
        },
        "connection_id": {
          "$ref": "#/$defs/host_id"
        },
        "correlation_id": {
          "$ref": "#/$defs/uuid"
        },
        "payload": {
          "$ref": "#/$defs/result_payload"
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "OK"
            },
            "error": {
              "const": null
            },
            "payload": {
              "properties": {
                "transfer": {
                  "const": "UPLOADED"
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "ERROR"
            },
            "error": {
              "allOf": [
                {
                  "$ref": "#/$defs/artifact_error"
                },
                {
                  "properties": {
                    "code": {
                      "const": "UPLOAD_EXPIRED"
                    }
                  }
                }
              ]
            },
            "payload": {
              "properties": {
                "transfer": {
                  "const": "EXPIRED"
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "ERROR"
            },
            "error": {
              "allOf": [
                {
                  "$ref": "#/$defs/artifact_error"
                },
                {
                  "properties": {
                    "code": {
                      "enum": [
                        "CANDIDATE_UNAVAILABLE",
                        "ARTIFACT_BUSY",
                        "ARTIFACT_BLOCKED",
                        "UPLOAD_FAILED",
                        "SESSION_TERMINATED",
                        "INTERNAL"
                      ]
                    }
                  }
                }
              ]
            },
            "payload": {
              "properties": {
                "transfer": {
                  "const": "FAILED"
                }
              }
            }
          }
        }
      ]
    }
  ]
}

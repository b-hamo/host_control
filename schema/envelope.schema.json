{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrp.local/schema/envelope.schema.json",
  "title": "SCRP Envelope v1.0",
  "description": "Common envelope for every SCRP control/telemetry message (Secure_CUA_Protocol_W1_v0.1 section 5). One WebSocket text frame = one JSON object matching this schema. payload is validated separately by schema/payload/<type>.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "session_id", "runtime_id", "generation", "connection_id",
    "message_id", "task_id", "action_id", "sequence_number", "timestamp",
    "nonce", "type", "correlation_id", "status", "error", "payload"
  ],
  "properties": {
    "version": { "const": "1.0" },
    "session_id": { "$ref": "#/$defs/host_id" },
    "runtime_id": { "$ref": "#/$defs/host_id" },
    "generation": { "type": "integer", "minimum": 1 },
    "connection_id": { "oneOf": [ { "$ref": "#/$defs/host_id" }, { "type": "null" } ] },
    "message_id": { "$ref": "#/$defs/uuid_v4" },
    "task_id": { "oneOf": [ { "$ref": "#/$defs/host_id" }, { "type": "null" } ] },
    "action_id": { "oneOf": [ { "$ref": "#/$defs/host_id" }, { "type": "null" } ] },
    "sequence_number": { "type": "integer", "minimum": 1 },
    "timestamp": {
      "type": "string",
      "description": "UTC RFC 3339, Z suffix only",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "nonce": {
      "type": "string",
      "description": "128-bit random value, base64url without padding (22 chars)",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "type": { "$ref": "#/$defs/message_type" },
    "correlation_id": { "oneOf": [ { "$ref": "#/$defs/uuid_v4" }, { "type": "null" } ] },
    "status": { "oneOf": [ { "type": "string", "minLength": 1, "maxLength": 32 }, { "type": "null" } ] },
    "error": { "oneOf": [ { "$ref": "#/$defs/error" }, { "type": "null" } ] },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "$comment": "Action family: task_id and action_id must be present (Broker issues an Action ID for every observe/input/execute request, spec B-4).",
      "if": { "properties": { "type": { "enum": ["OBSERVE", "OBSERVE_RESULT", "ACTION_REQUEST", "ACK", "ACTION_RESULT"] } } },
      "then": { "properties": { "task_id": { "type": "string" }, "action_id": { "type": "string" } } }
    },
    {
      "$comment": "Requests and events carry no correlation/status/error.",
      "if": { "properties": { "type": { "enum": ["HELLO", "OBSERVE", "ACTION_REQUEST", "STATE_REQUEST", "HEARTBEAT", "ARTIFACT_REQUEST", "TERMINATE", "CHANNEL_HELLO", "SECURITY_EVENT"] } } },
      "then": { "properties": { "correlation_id": { "type": "null" }, "status": { "type": "null" }, "error": { "type": "null" } } }
    },
    {
      "$comment": "Responses must reference the original message_id and carry a status.",
      "if": { "properties": { "type": { "enum": ["HELLO_ACK", "OBSERVE_RESULT", "ACK", "ACTION_RESULT", "STATE_RESULT", "ALIVE", "ARTIFACT_RESULT", "TERMINATE_RESULT", "CHANNEL_ACK", "EVENT_ACK"] } } },
      "then": { "properties": { "correlation_id": { "type": "string" }, "status": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "ACK" } } },
      "then": { "properties": { "status": { "enum": ["ACCEPTED", "REJECTED"] } } }
    },
    {
      "if": { "properties": { "type": { "const": "ACTION_RESULT" } } },
      "then": { "properties": { "status": { "enum": ["SUCCESS", "PARTIAL_SUCCESS", "FAILED", "UNKNOWN", "BLOCKED"] } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["HELLO_ACK", "OBSERVE_RESULT", "STATE_RESULT", "ALIVE", "ARTIFACT_RESULT", "TERMINATE_RESULT", "CHANNEL_ACK", "EVENT_ACK"] } } },
      "then": { "properties": { "status": { "enum": ["OK", "ERROR"] } } }
    },
    {
      "if": { "properties": { "type": { "const": "ERROR" } } },
      "then": { "properties": { "status": { "const": "ERROR" }, "error": { "type": "object" } } }
    },
    {
      "$comment": "HELLO is the first message on a connection: sequence 1, no connection_id yet.",
      "if": { "properties": { "type": { "const": "HELLO" } } },
      "then": { "properties": { "sequence_number": { "const": 1 }, "connection_id": { "type": "null" } } }
    },
    {
      "if": { "properties": { "type": { "const": "HELLO_ACK" } } },
      "then": { "properties": { "sequence_number": { "const": 1 }, "connection_id": { "type": "string" } } }
    }
  ],
  "$defs": {
    "host_id": {
      "type": "string",
      "description": "Host-issued identifier. Never trusted for authorization; matched against the authenticated context.",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "uuid_v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "message_type": {
      "description": "Closed set of allowed message types (spec E-2). Anything else is PROTOCOL_DENIED.",
      "enum": [
        "HELLO", "HELLO_ACK",
        "OBSERVE", "OBSERVE_RESULT",
        "ACTION_REQUEST", "ACK", "ACTION_RESULT",
        "STATE_REQUEST", "STATE_RESULT",
        "HEARTBEAT", "ALIVE",
        "ARTIFACT_REQUEST", "ARTIFACT_RESULT",
        "TERMINATE", "TERMINATE_RESULT",
        "ERROR",
        "CHANNEL_HELLO", "CHANNEL_ACK",
        "SECURITY_EVENT", "EVENT_ACK"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "recommended_next_step"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT", "POLICY_DENIED", "PROTOCOL_DENIED", "UNSUPPORTED_TYPE",
            "MESSAGE_TOO_LARGE", "STALE_OBSERVATION", "RATE_LIMITED",
            "RUNTIME_UNAVAILABLE", "RUNTIME_START_FAILED", "ACTION_FAILED", "ACTION_TIMEOUT",
            "SECURITY_BLOCKED", "ARTIFACT_BLOCKED", "SESSION_TERMINATED", "INTERNAL"
          ]
        },
        "message": { "type": "string", "maxLength": 1024 },
        "retryable": { "type": "boolean" },
        "recommended_next_step": { "oneOf": [ { "type": "string", "maxLength": 64 }, { "type": "null" } ] }
      }
    }
  }
}
